 knobChanged "n=nuke.thisNode()\nk=nuke.thisKnob()\nif k.name() in ('asset_name', 'subname', 'showPanel'):\n import os, getpass\n p=os.environ.get('BUCK_PROJECT_PATH')\n u=getpass.getuser()\n a=n\['asset_name'].value()\n s=n\['subname'].value()\n if not p:\n  r=n.node('Read11')\n  if r:\n   f=r\['file'].value().replace('\\\\', '/')\n   if '/Production/' in f:\n    p=f.split('/Production/')\[0]\n msg = os.path.join(p, 'Production/MAYA/sourceimages/work.'+u+'/_CHARON', a, s).replace('\\\\', '/') if p else 'Path Not Found'\n n\['path_preview'].setValue(msg)\n try:\n  root=nuke.root()\n  mode='sRGB'\n  try:\n   cm=root['colorManagement'].value()\n   if 'OCIO' in str(cm).upper():\n    mode='ACES'\n  except Exception:\n   pass\n  try:\n   n['aces_mode'].setValue(mode)\n  except Exception:\n   try:\n    n['aces_mode'].setValue(1 if mode == 'ACES' else 0)\n   except Exception:\n    pass\n  try:\n   n['aces_mode'].setEnabled(False)\n  except Exception:\n   pass\n  try:\n   if not root.knob('charon_color_mode_hook'):\n    k=nuke.String_Knob('charon_color_mode_hook', '', '')\n    k.setFlag(nuke.NO_ANIMATION | nuke.INVISIBLE)\n    root.addKnob(k)\n    def _charon_color_mode_hook():\n     try:\n      kb=nuke.thisKnob()\n      if kb and kb.name() != 'colorManagement':\n       return\n     except Exception:\n      pass\n     try:\n      cm_val=root['colorManagement'].value()\n     except Exception:\n      cm_val=''\n     mode='ACES' if 'OCIO' in str(cm_val).upper() else 'sRGB'\n     try:\n      for node in nuke.allNodes(recurseGroups=True):\n       if node.knob('aces_mode'):\n        try:\n         node['aces_mode'].setValue(mode)\n        except Exception:\n         try:\n          node['aces_mode'].setValue(1 if mode == 'ACES' else 0)\n         except Exception:\n          pass\n     except Exception:\n      pass\n    nuke.addKnobChanged(_charon_color_mode_hook, nodeClass='Root')\n  except Exception:\n   pass\n except Exception:\n  pass\n"
