 knobChanged "n=nuke.thisNode()\nk=nuke.thisKnob()\nif k.name() in ('asset_name', 'subname', 'showPanel'):\n import os, getpass\n p=os.environ.get('BUCK_PROJECT_PATH')\n u=getpass.getuser()\n a=n\['asset_name'].value()\n s=n\['subname'].value()\n if not p:\n  r=n.node('Read11')\n  if r:\n   f=r\['file'].value().replace('\\\\', '/')\n   if '/Production/' in f:\n    p=f.split('/Production/')\[0]\n msg = os.path.join(p, 'Production/MAYA/sourceimages/work.'+u+'/_CHARON', a, s).replace('\\\\', '/') if p else 'Path Not Found'\n n\['path_preview'].setValue(msg)\n try:\n  n\['path_preview'].setTooltip(msg)\n except Exception:\n  pass\n try:\n  root=nuke.root()\n  mode='sRGB'\n  def _charon_get_color_management():\n   try:\n    for name in ('colorManagement', 'OCIO_config', 'ocio_config', 'color_management'):\n     try:\n      if root.knob(name):\n       return root\[name].value()\n     except Exception:\n      pass\n   except Exception:\n    pass\n   return ''\n  try:\n   cm=_charon_get_color_management()\n   if 'OCIO' in str(cm).upper():\n    mode='ACES'\n  except Exception:\n   pass\n  try:\n   n\['aces_mode'].setValue(mode)\n  except Exception:\n   try:\n    n\['aces_mode'].setValue(1 if mode == 'ACES' else 0)\n   except Exception:\n    pass\n  try:\n   n\['aces_mode'].setEnabled(False)\n  except Exception:\n   pass\n  try:\n   if not root.knob('charon_color_mode_hook'):\n    k=nuke.String_Knob('charon_color_mode_hook', '', '')\n    k.setFlag(nuke.NO_ANIMATION | nuke.INVISIBLE)\n    root.addKnob(k)\n  except Exception:\n   pass\n  try:\n   if not hasattr(nuke, '_charon_color_mode_hook_installed'):\n    nuke._charon_color_mode_hook_installed = False\n   if not nuke._charon_color_mode_hook_installed:\n    def _charon_color_mode_hook():\n     try:\n      kb=nuke.thisKnob()\n      kb_name=kb.name() if kb else ''\n      if kb_name and kb_name not in ('colorManagement', 'OCIO_config', 'ocio_config', 'color_management'):\n       return\n     except Exception:\n      pass\n     try:\n      cm_val=_charon_get_color_management()\n     except Exception:\n      cm_val=''\n     mode='ACES' if 'OCIO' in str(cm_val).upper() else 'sRGB'\n     try:\n      for node in nuke.allNodes(recurseGroups=True):\n       if node.knob('aces_mode'):\n        try:\n         node\['aces_mode'].setValue(mode)\n        except Exception:\n         try:\n          node\['aces_mode'].setValue(1 if mode == 'ACES' else 0)\n         except Exception:\n          pass\n     except Exception:\n      pass\n    nuke.addKnobChanged(_charon_color_mode_hook, nodeClass='Root')\n    nuke._charon_color_mode_hook_installed = True\n  except Exception:\n   pass\n except Exception:\n  pass\n"
