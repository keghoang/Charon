 addUserKnob {22 project_texture l "Project Texture" T "n=nuke.thisNode()\n_DEBUG = False\ntry:\n  import os\n  env=os.environ.get('CHARON_TEXTURE_BAKE_DEBUG')\n  if env is not None:\n    _DEBUG = bool(int(env))\nexcept Exception:\n  pass\n\ndef _debug(message):\n  if _DEBUG:\n    print('\[TextureBake] ' + message)\n\ndef _resolve(node, max_hops=32):\n  cur=node\n  visited=set()\n  hops=0\n  while cur and hops<max_hops:\n    if cur in visited:\n      break\n    visited.add(cur)\n    try:\n      if cur.Class() not in ('Dot','NoOp'):\n        return cur\n    except Exception:\n      return cur\n    try:\n      cur=cur.input(0)\n    except Exception:\n      cur=None\n    hops+=1\n  return node\n\ndef _find_upstream(start_node, class_names, max_hops=32):\n  current=start_node\n  visited=set()\n  hops=0\n  while current and hops<max_hops:\n    if current in visited:\n      break\n    visited.add(current)\n    try:\n      if current.Class() in class_names:\n        return current\n    except Exception:\n      pass\n    try:\n      current=current.input(0)\n    except Exception:\n      current=None\n    hops+=1\n  return None\n\ndef _collect_rig_cam_count(rig):\n  if not rig or not hasattr(rig, 'begin'):\n    return 0\n  rig.begin()\n  try:\n    cams=\[node for node in nuke.allNodes() if node.Class() in ('Camera3','Camera2','Camera') and node.name().startswith('Cam')]\n    return len(cams)\n  finally:\n    rig.end()\n\ndef _current_cam_count(group):\n  group.begin()\n  try:\n    cams=\[node for node in nuke.allNodes() if node.Class() in ('Camera3','Camera2','Camera') and node.name().startswith('Cam')]\n    return len(cams)\n  finally:\n    group.end()\n\ndef _ensure_rig_count_knob(group):\n  knob=group.knob('charon_rig_cam_count')\n  if knob:\n    return knob\n  knob=nuke.Int_Knob('charon_rig_cam_count', 'Projection Cameras Found')\n  try:\n    knob.setEnabled(False)\n  except Exception:\n    knob.setFlag(nuke.DISABLED)\n  group.addKnob(knob)\n  return knob\n\ndef _update_rig_camera_count(group, rig):\n  count=_collect_rig_cam_count(rig)\n  knob=_ensure_rig_count_knob(group)\n  try:\n    knob.setValue(count)\n  except Exception:\n    try:\n      knob.setValue(int(count))\n    except Exception:\n      pass\n\ndef _read_group_block(template_path):\n  try:\n    with open(template_path, 'r') as handle:\n      content=handle.read()\n  except Exception as exc:\n    _debug('failed to read template: \{0\}'.format(exc))\n    return None\n\n  lines=content.splitlines(True)\n  start_line=None\n  end_line=None\n  depth=0\n  for idx, line in enumerate(lines):\n    stripped=line.lstrip()\n    if stripped.startswith('Group \{'):\n      if start_line is None:\n        start_line=idx\n      depth+=1\n    elif stripped.startswith('end_group'):\n      if depth > 0:\n        depth-=1\n        if depth == 0 and start_line is not None:\n          end_line=idx\n          break\n  if start_line is None or end_line is None:\n    _debug('template missing Group block')\n    return None\n  return ''.join(lines\[start_line:end_line + 1]) + '\\n'\n\ndef _paste_group(script_content):\n  import tempfile\n  temp_path=''\n  try:\n    with tempfile.NamedTemporaryFile(mode='w', suffix='.nk', delete=False) as handle:\n      handle.write(script_content)\n      temp_path=handle.name\n    for node in nuke.allNodes(recurseGroups=True):\n      node.setSelected(False)\n    nuke.nodePaste(temp_path)\n    for node in nuke.selectedNodes():\n      if node.Class()=='Group':\n        return node\n  except Exception as exc:\n    _debug('paste failed: \{0\}'.format(exc))\n  finally:\n    if temp_path and os.path.exists(temp_path):\n      try:\n        os.unlink(temp_path)\n      except Exception:\n        pass\n  return None\n\ndef _collect_dependents(node):\n  deps=\[]\n  for other in nuke.allNodes(recurseGroups=False):\n    for i in range(other.inputs()):\n      try:\n        if other.input(i)==node:\n          deps.append((other,i))\n      except Exception:\n        pass\n  return deps\n\ndef _ensure_template_knob(group):\n  knob=group.knob('charon_template_dir')\n  if knob:\n    return knob\n  knob=nuke.String_Knob('charon_template_dir','Template Dir','')\n  knob.setFlag(nuke.NO_ANIMATION | nuke.INVISIBLE)\n  group.addKnob(knob)\n  return knob\n\ndef _resolve_template_dir(group):\n  import os\n  import sys\n  template_dir=''\n  knob=None\n  try:\n    knob=_ensure_template_knob(group)\n  except Exception:\n    knob=None\n  if knob:\n    try:\n      template_dir=knob.value()\n    except Exception:\n      template_dir=''\n  if template_dir and os.path.exists(template_dir):\n    return template_dir\n  candidates=\[]\n  try:\n    env_dir=os.environ.get('CHARON_TEMPLATE_DIR') or ''\n  except Exception:\n    env_dir=''\n  if env_dir:\n    candidates.append(env_dir)\n  try:\n    import charon.paths as _charon_paths\n    candidates.append(os.path.join(_charon_paths.RESOURCE_DIR, 'nuke_template'))\n  except Exception:\n    pass\n  try:\n    for entry in list(sys.path):\n      if not entry:\n        continue\n      candidates.append(os.path.join(entry, 'charon', 'resources', 'nuke_template'))\n      candidates.append(os.path.join(entry, 'resources', 'nuke_template'))\n  except Exception:\n    pass\n  try:\n    import nuke as _nuke\n    for entry in _nuke.pluginPath():\n      if not entry:\n        continue\n      candidates.append(os.path.join(entry, 'charon', 'resources', 'nuke_template'))\n      candidates.append(os.path.join(entry, 'resources', 'nuke_template'))\n  except Exception:\n    pass\n  for candidate in candidates:\n    if candidate and os.path.exists(candidate):\n      candidate=os.path.normpath(candidate)\n      try:\n        if knob:\n          knob.setValue(candidate)\n        elif group.knob('charon_template_dir'):\n          group\['charon_template_dir'].setValue(candidate)\n      except Exception:\n        pass\n      return candidate\n  return template_dir\n\ndef _copy_knob_values(src, dst, names):\n  for name in names:\n    try:\n      if src.knob(name) and dst.knob(name):\n        dst\[name].setValue(src\[name].value())\n    except Exception:\n      pass\n\n\ndef _unique_name(base):\n  try:\n    existing=set(n.name() for n in nuke.allNodes(recurseGroups=False))\n  except Exception:\n    existing=set()\n  if base not in existing:\n    return base\n  idx=1\n  while True:\n    candidate='\{0\}_\{1\}'.format(base, idx)\n    if candidate not in existing:\n      return candidate\n    idx+=1\n\ndef _rebuild_for_count(group, count):\n  try:\n    count=int(count)\n  except Exception:\n    return None\n  template_dir=_resolve_template_dir(group)\n  if not template_dir:\n    nuke.message('Template directory missing.')\n    return None\n  template_path=os.path.normpath(os.path.join(template_dir, 'projection_texture_bake_\{0\}_cams.nk'.format(count)))\n  if not os.path.exists(template_path):\n    nuke.message('Template not found for \{0\} cams.'.format(count))\n    return None\n  script_content=_read_group_block(template_path)\n  if not script_content:\n    return None\n\n  input_nodes=\[group.input(i) for i in range(group.inputs())]\n  old_name=group.name()\n  old_pos=(group.xpos(), group.ypos())\n  downstream=_collect_dependents(group)\n  values=\{\}\n  for name in \['asset_name','subname','aces_mode','uvsize','bake_resolution']:\n    try:\n      if group.knob(name):\n        values\[name]=group\[name].value()\n    except Exception:\n      pass\n\n  root=nuke.root()\n  current_group=nuke.thisGroup()\n  root.begin()\n  new_group=_paste_group(script_content)\n  if not new_group:\n    nuke.message('Failed to rebuild bake group.')\n    return None\n\n  for idx, inp in enumerate(input_nodes):\n    try:\n      new_group.setInput(idx, inp)\n    except Exception:\n      pass\n  try:\n    new_group.setXYpos(old_pos\[0], old_pos\[1])\n  except Exception:\n    pass\n  _copy_knob_values(group, new_group, values.keys())\n\n  for dep, idx in downstream:\n    try:\n      dep.setInput(idx, new_group)\n    except Exception:\n      pass\n\n  temp_name=_unique_name('\{0\}_OLD'.format(old_name))\n  try:\n    group.setName(temp_name)\n  except Exception:\n    pass\n  try:\n    new_group.setName(old_name)\n  except Exception:\n    pass\n  try:\n    nuke.delete(group)\n  except Exception:\n    pass\n\n  _ensure_template_knob(new_group)\n  try:\n    new_group\['charon_template_dir'].setValue(template_dir)\n  except Exception:\n    pass\n\n  if current_group and current_group is not root:\n    current_group.begin()\n  return new_group\n\ndef _update_geo(group, geo_node):\n  if not geo_node:\n    return False\n  _debug('update_geo input: \{0\} (\{1\})'.format(geo_node.name(), geo_node.Class()))\n  if geo_node.Class() not in ('ReadGeo2','ReadGeo'):\n    upstream=_find_upstream(geo_node, ('ReadGeo2','ReadGeo'))\n    if upstream:\n      _debug('resolved upstream geo: \{0\} (\{1\})'.format(upstream.name(), upstream.Class()))\n      geo_node=upstream\n    else:\n      nuke.message('Geo input must be a ReadGeo/ReadGeo2 node.')\n      return False\n\n  parent=geo_node.parent() if hasattr(geo_node, 'parent') else None\n  if not parent:\n    parent=nuke.root()\n  current_group=nuke.thisGroup()\n  parent.begin()\n  original_selection=list(nuke.selectedNodes())\n  for n in original_selection:\n    n.setSelected(False)\n  temp_path=''\n  copy_ok=True\n  try:\n    geo_node.setSelected(True)\n    try:\n      import tempfile\n      handle=tempfile.NamedTemporaryFile(suffix='.nk', delete=False)\n      temp_path=handle.name\n      handle.close()\n      nuke.nodeCopy(temp_path)\n    except Exception as exc:\n      _debug('update_geo copy failed: \{0\}'.format(exc))\n      copy_ok=False\n  finally:\n    geo_node.setSelected(False)\n    for n in original_selection:\n      try:\n        n.setSelected(True)\n      except Exception:\n        pass\n    if current_group and current_group is not parent:\n      current_group.begin()\n  if not copy_ok:\n    if temp_path:\n      try:\n        import os\n        if os.path.exists(temp_path):\n          os.remove(temp_path)\n      except Exception:\n        pass\n    return False\n\n  group.begin()\n  try:\n    before_nodes=set(nuke.allNodes())\n    for n in nuke.selectedNodes():\n      n.setSelected(False)\n    try:\n      if temp_path:\n        nuke.nodePaste(temp_path)\n      else:\n        nuke.nodePaste('%clipboard%')\n    except Exception as exc:\n      _debug('update_geo paste failed: \{0\}'.format(exc))\n      try:\n        nuke.nodePaste('%clipboard%')\n      except Exception:\n        pass\n    pasted_nodes=list(nuke.selectedNodes())\n    after_nodes=\[node for node in nuke.allNodes() if node not in before_nodes]\n    if not after_nodes and not pasted_nodes:\n      nuke.message('Failed to paste geo node.')\n      return False\n\n    pasted=None\n    for node in pasted_nodes + after_nodes:\n      if node.Class() in ('ReadGeo2','ReadGeo'):\n        pasted=node\n        break\n    if pasted is None:\n      pasted=(pasted_nodes or after_nodes)\[0]\n\n    existing_geos=\[node for node in nuke.allNodes() if node.Class() in ('ReadGeo2','ReadGeo') and node is not pasted]\n\n    def _is_clone(node):\n      try:\n        return bool(node.isClone())\n      except Exception:\n        return False\n\n    def _collect_connections(nodes):\n      connections=\{node: \[] for node in nodes\}\n      for node in nuke.allNodes(recurseGroups=True):\n        for i in range(node.inputs()):\n          try:\n            inp=node.input(i)\n          except Exception:\n            continue\n          if inp in connections:\n            connections\[inp].append((node,i))\n      return connections\n\n    def _create_clone(master):\n      for n in nuke.selectedNodes():\n        n.setSelected(False)\n      master.setSelected(True)\n      before=set(nuke.allNodes())\n      if hasattr(nuke, 'clone'):\n        try:\n          nuke.clone(master)\n        except TypeError:\n          nuke.clone()\n      else:\n        nuke.nodeCopy('%clipboard%')\n        nuke.nodePaste('%clipboard%')\n      created=\[node for node in nuke.allNodes() if node not in before]\n      if created:\n        return created\[0]\n      return None\n\n    if not existing_geos:\n      default_name='ReadGeo' if geo_node.Class()=='ReadGeo' else 'ReadGeo2'\n      try:\n        pasted.setName(default_name, unique=True)\n      except Exception:\n        pasted.setName(default_name)\n      return True\n\n    master_old=None\n    for node in existing_geos:\n      if node.name() in ('ReadGeo2','ReadGeo'):\n        master_old=node\n        break\n    if master_old is None:\n      for node in existing_geos:\n        if not _is_clone(node):\n          master_old=node\n          break\n    if master_old is None:\n      master_old=existing_geos\[0]\n\n    geo_specs=\[]\n    for node in existing_geos:\n      try:\n        input_nodes=\[node.input(i) for i in range(node.inputs())]\n      except Exception:\n        input_nodes=\[]\n      geo_specs.append(\{\n        'node': node,\n        'name': node.name(),\n        'pos': (node.xpos(), node.ypos()),\n        'is_master': node is master_old,\n        'inputs': input_nodes,\n      \})\n    connections=_collect_connections(\[spec\['node'] for spec in geo_specs])\n\n    new_nodes=\{\}\n    for spec in geo_specs:\n      if spec\['is_master']:\n        new_nodes\[spec\['node']]=pasted\n      else:\n        clone=_create_clone(pasted)\n        if clone:\n          new_nodes\[spec\['node']]=clone\n        else:\n          new_nodes\[spec\['node']]=pasted\n\n    for spec in geo_specs:\n      old_node=spec\['node']\n      new_node=new_nodes.get(old_node)\n      if new_node is None:\n        continue\n      inputs=spec.get('inputs', \[])\n      for idx, inp in enumerate(inputs):\n        if inp is None:\n          try:\n            new_node.setInput(idx, None)\n          except Exception:\n            pass\n          continue\n        replacement=new_nodes.get(inp, inp)\n        try:\n          new_node.setInput(idx, replacement)\n        except Exception:\n          pass\n\n    for old_node, new_node in new_nodes.items():\n      if old_node is new_node:\n        continue\n      for dep, idx in connections.get(old_node, \[]):\n        try:\n          dep.setInput(idx, new_node)\n        except Exception:\n          pass\n\n    for spec in geo_specs:\n      old_node=spec\['node']\n      new_node=new_nodes.get(old_node)\n      if new_node is None:\n        continue\n      try:\n        new_node.setXYpos(spec\['pos']\[0], spec\['pos']\[1])\n      except Exception:\n        pass\n\n    for spec in geo_specs:\n      old_node=spec\['node']\n      try:\n        nuke.delete(old_node)\n      except Exception:\n        pass\n\n    for spec in geo_specs:\n      new_node=new_nodes.get(spec\['node'])\n      if new_node is None:\n        continue\n      try:\n        new_node.setName(spec\['name'], unique=True)\n      except Exception:\n        try:\n          new_node.setName(spec\['name'])\n        except Exception:\n          pass\n\n    return True\n  finally:\n    try:\n      if temp_path:\n        import os\n        if os.path.exists(temp_path):\n          os.remove(temp_path)\n    except Exception:\n      pass\n    group.end()\n\n\ndef _resolve_camera_input(node):\n  if not node:\n    return None\n  node=_resolve(node)\n  try:\n    if node and node.Class() in ('Camera3','Camera2','Camera'):\n      return node\n  except Exception:\n    pass\n  upstream=_find_upstream(node, ('Camera3','Camera2','Camera'))\n  if upstream:\n    return upstream\n  return None\n\ndef _safe_input(group, index):\n  try:\n    return group.input(index)\n  except Exception:\n    return None\n\ndef _collect_dependents_in_group(target):\n  deps=\[]\n  for other in nuke.allNodes():\n    for i in range(other.inputs()):\n      try:\n        if other.input(i)==target:\n          deps.append((other,i))\n      except Exception:\n        pass\n  return deps\n\ndef _update_camera_from_input(group, cam_node, target_name):\n  if not cam_node:\n    _debug('update_camera missing cam for ' + str(target_name))\n    return False\n\n  def _camera_target(cam):\n    try:\n      if cam and cam.inputs() > 1:\n        return cam.input(1)\n    except Exception:\n      pass\n    return None\n\n  def _safe_name(node):\n    try:\n      return node.name()\n    except Exception:\n      return ''\n\n  def _safe_class(node):\n    try:\n      return node.Class()\n    except Exception:\n      return ''\n\n  def _expected_target_name(cam_name):\n    try:\n      if not cam_name:\n        return ''\n      if cam_name == 'Charon_InitCam':\n        return 'Charon_CamTarget'\n      if cam_name.startswith('Cam_'):\n        return cam_name + '_CamTarget'\n    except Exception:\n      pass\n    return ''\n\n  input_target=_camera_target(cam_node)\n  input_has_target=bool(input_target)\n  _debug('input cam=' + _safe_name(cam_node) + ' class=' + _safe_class(cam_node) + ' target=' + _safe_name(input_target))\n\n  root=nuke.root()\n  current_group=nuke.thisGroup()\n  copy_parent=None\n  try:\n    if hasattr(cam_node, 'parent'):\n      copy_parent=cam_node.parent()\n  except Exception:\n    copy_parent=None\n  if not copy_parent:\n    copy_parent=root\n\n  temp_path=''\n  copy_parent.begin()\n  _debug('copy parent=' + _safe_name(copy_parent) + ' class=' + _safe_class(copy_parent))\n  original_selection=list(nuke.selectedNodes())\n  for n in original_selection:\n    n.setSelected(False)\n  try:\n    cam_node.setSelected(True)\n    if input_target and input_target is not cam_node:\n      try:\n        input_target.setSelected(True)\n      except Exception:\n        pass\n    try:\n      import tempfile\n      handle=tempfile.NamedTemporaryFile(suffix='.nk', delete=False)\n      temp_path=handle.name\n      handle.close()\n      _debug('nodeCopy to ' + temp_path)\n      nuke.nodeCopy(temp_path)\n    except Exception as exc:\n      _debug('nodeCopy failed: ' + str(exc))\n      return False\n  finally:\n    cam_node.setSelected(False)\n    if input_target and input_target is not cam_node:\n      try:\n        input_target.setSelected(False)\n      except Exception:\n        pass\n    for n in original_selection:\n      try:\n        n.setSelected(True)\n      except Exception:\n        pass\n    if current_group and current_group is not copy_parent:\n      current_group.begin()\n\n  group.begin()\n  try:\n    before_nodes=set(nuke.allNodes())\n    for n in nuke.selectedNodes():\n      n.setSelected(False)\n    try:\n      if temp_path:\n        nuke.nodePaste(temp_path)\n      else:\n        nuke.nodePaste('%clipboard%')\n    except Exception as exc:\n      _debug('nodePaste failed: ' + str(exc))\n      return False\n    pasted_nodes=list(nuke.selectedNodes())\n    after_nodes=[node for node in nuke.allNodes() if node not in before_nodes]\n    created_nodes=[]\n    for node in pasted_nodes + after_nodes:\n      if node not in created_nodes:\n        created_nodes.append(node)\n\n    new_cam=None\n    for node in created_nodes:\n      try:\n        if node.Class() in ('Camera3','Camera2','Camera'):\n          new_cam=node\n          break\n      except Exception:\n        pass\n    if not new_cam:\n      try:\n        summary=[_safe_name(n) + ':' + _safe_class(n) for n in created_nodes]\n      except Exception:\n        summary=[]\n      _debug('paste produced no camera for ' + str(target_name) + ' created=' + str(summary))\n      return False\n\n    new_target=None\n    if input_has_target:\n      try:\n        if new_cam.inputs() > 1:\n          candidate=new_cam.input(1)\n          if candidate in created_nodes:\n            new_target=candidate\n      except Exception:\n        pass\n      if not new_target:\n        for node in created_nodes:\n          if node is new_cam:\n            continue\n          try:\n            if node.Class() in ('Axis3','Axis2','Axis') or 'CamTarget' in node.name():\n              new_target=node\n              break\n          except Exception:\n            pass\n    if input_has_target:\n      _debug('pasted cam=' + _safe_name(new_cam) + ' target=' + _safe_name(new_target))\n\n    old_cam=nuke.toNode(target_name)\n    if not old_cam:\n      try:\n        new_cam.setName(target_name, unique=True)\n      except Exception:\n        try:\n          new_cam.setName(target_name)\n        except Exception:\n          pass\n      if new_target:\n        expected=_expected_target_name(target_name)\n        if expected:\n          try:\n            new_target.setName(expected, unique=True)\n          except Exception:\n            try:\n              new_target.setName(expected)\n            except Exception:\n              pass\n      return True\n\n    try:\n      old_inputs=[old_cam.input(i) for i in range(old_cam.inputs())]\n    except Exception:\n      old_inputs=[]\n    deps=_collect_dependents_in_group(old_cam)\n\n    replace_target=bool(input_has_target and new_target)\n\n    target_nodes=[]\n    if old_inputs:\n      for idx, inp in enumerate(list(old_inputs)):\n        if not inp:\n          continue\n        try:\n          inp_name=inp.name()\n        except Exception:\n          inp_name=''\n        if 'CamTarget' in inp_name:\n          target_nodes.append(inp)\n          if replace_target or not input_has_target:\n            old_inputs[idx]=None\n\n    for idx, inp in enumerate(old_inputs):\n      if replace_target and idx == 1:\n        continue\n      try:\n        new_cam.setInput(idx, inp)\n      except Exception:\n        pass\n\n    if replace_target:\n      try:\n        new_cam.setInput(1, new_target)\n      except Exception:\n        pass\n    elif input_has_target and not new_target:\n      _debug('input target missing after paste; keeping existing target')\n\n    for dep, idx in deps:\n      try:\n        dep.setInput(idx, new_cam)\n      except Exception:\n        pass\n\n    try:\n      new_cam.setXYpos(old_cam.xpos(), old_cam.ypos())\n    except Exception:\n      pass\n\n    try:\n      nuke.delete(old_cam)\n    except Exception:\n      pass\n\n    try:\n      new_cam.setName(target_name, unique=True)\n    except Exception:\n      try:\n        new_cam.setName(target_name)\n      except Exception:\n        pass\n\n    if (replace_target or not input_has_target) and target_nodes:\n      expected=_expected_target_name(target_name)\n      for target_node in target_nodes:\n        try:\n          target_node_name=target_node.name()\n        except Exception:\n          target_node_name=''\n        should_delete=False\n        if expected:\n          should_delete = (target_node_name == expected)\n        else:\n          should_delete = ('CamTarget' in target_node_name)\n        if not should_delete:\n          continue\n        try:\n          target_deps=_collect_dependents_in_group(target_node)\n        except Exception:\n          target_deps=[]\n        if not target_deps:\n          try:\n            nuke.delete(target_node)\n          except Exception:\n            pass\n\n    if replace_target and new_target:\n      expected=_expected_target_name(target_name)\n      if expected:\n        try:\n          existing=nuke.toNode(expected)\n        except Exception:\n          existing=None\n        if existing and existing is not new_target:\n          try:\n            deps_existing=_collect_dependents_in_group(existing)\n          except Exception:\n            deps_existing=[]\n          if not deps_existing:\n            try:\n              nuke.delete(existing)\n              existing=None\n            except Exception:\n              pass\n        if not existing:\n          try:\n            new_target.setName(expected, unique=True)\n          except Exception:\n            try:\n              new_target.setName(expected)\n            except Exception:\n              pass\n\n    return True\n  finally:\n    group.end()\n    if temp_path:\n      try:\n        import os\n        if os.path.exists(temp_path):\n          os.remove(temp_path)\n      except Exception:\n        pass\n\ndef _projection_pairs():
  return [
    ('Image_MASTER', 'Cam_MASTER', 'Charon_InitCam', 1, 2),
    ('Image_2', 'Cam_2', 'Cam_02', 3, 4),
    ('Image_3', 'Cam_3', 'Cam_03', 5, 6),
    ('Image_4', 'Cam_4', 'Cam_04', 7, 8),
    ('Image_5', 'Cam_5', 'Cam_05', 9, 10),
    ('Image_6', 'Cam_6', 'Cam_06', 11, 12),
    ('Image_7', 'Cam_7', 'Cam_07', 13, 14),
    ('Image_8', 'Cam_8', 'Cam_08', 15, 16),
  ]

def _update_pair_count(group, count):\n  knob=_ensure_rig_count_knob(group)\n  try:\n    knob.setValue(int(count))\n  except Exception:\n    try:\n      knob.setValue(float(count))\n    except Exception:\n      pass\n\ndef _set_knob_visible(group, knob, visible, name=None):\n  if not knob:\n    return\n  label=name if name else (knob.name() if hasattr(knob, 'name') else '?')\n  try:\n    if visible and hasattr(nuke, 'INVISIBLE'):\n      knob.clearFlag(nuke.INVISIBLE)\n  except Exception as exc:\n    _debug('visibility clearFlag failed for ' + label + ': ' + str(exc))\n  try:\n    knob.setVisible(visible)\n  except Exception as exc:\n    _debug('visibility setVisible failed for ' + label + ': ' + str(exc))\n  try:\n    knob.setEnabled(visible)\n  except Exception as exc:\n    _debug('visibility setEnabled failed for ' + label + ': ' + str(exc))\n  try:\n    inv=knob.getFlag(nuke.INVISIBLE) if hasattr(nuke, 'INVISIBLE') else None\n  except Exception:\n    inv=None\n  try:\n    en=knob.enabled()\n  except Exception:\n    en=None\n  _debug('visibility knob=\{0\} visible=\{1\} inv=\{2\} enabled=\{3\}'.format(label, visible, inv, en))\n  if visible and inv:\n    try:\n      group.removeKnob(knob)\n      group.addKnob(knob)\n      if hasattr(nuke, 'INVISIBLE'):\n        knob.clearFlag(nuke.INVISIBLE)\n      knob.setVisible(True)\n      knob.setEnabled(True)\n      fresh = group.knob(label)\n      if fresh:\n        try:\n          inv2 = fresh.getFlag(nuke.INVISIBLE) if hasattr(nuke, 'INVISIBLE') else None\n        except Exception:\n          inv2 = None\n        _debug('visibility re-added knob: \{0\} inv=\{1\}'.format(label, inv2))\n      else:\n        _debug('visibility re-add could not refetch knob: ' + label)\n    except Exception as exc:\n      _debug('visibility re-add failed for ' + label + ': ' + str(exc))\n\ndef _set_node_knob(group, node_name, knob_name, value):\n  if not node_name or not knob_name:\n    return\n  group.begin()\n  try:\n    node=nuke.toNode(node_name)\n    if not node:\n      return\n    if knob_name in node.knobs():\n      node\[knob_name].setValue(value)\n  except Exception as exc:\n    _debug('zero set failed for \{0\}.\{1\}: \{2\}'.format(node_name, knob_name, exc))\n  finally:\n    group.end()\n\ndef _ensure_active_cam_mask(group):\n  knob=group.knob('charon_active_cam_mask')\n  if knob:\n    return knob\n  knob=nuke.Int_Knob('charon_active_cam_mask', 'Active Cam Mask')\n  knob.setFlag(nuke.NO_ANIMATION | nuke.INVISIBLE)\n  group.addKnob(knob)\n  return knob\n\ndef _get_active_cam_mask(group):\n  knob=_ensure_active_cam_mask(group)\n  try:\n    return int(knob.value())\n  except Exception:\n    return 0\n\ndef _set_active_cam_mask(group, mask):\n  knob=_ensure_active_cam_mask(group)\n  try:\n    knob.setValue(int(mask))\n  except Exception:\n    pass\n\ndef _zero_camera_controls(group, idx):\n  try:\n    idx_int=int(idx)\n  except Exception:\n    return\n  if idx_int < 2 or idx_int > 8:\n    return\n  suffix=str(idx_int).zfill(2)\n  _set_node_knob(group, 'toggle_cam_' + suffix, 'mix', 0)\n\ndef _apply_camera_knob_visibility(group, pairs):\n  active=\{1: True\}\n  for idx, spec in enumerate(pairs, start=1):\n    if idx == 1:\n      active\[idx]=True\n      continue\n    try:\n      cam=spec\[4]\n    except Exception:\n      cam=None\n    active\[idx]=bool(cam)\n\n  knob_map=\{\}\n  try:\n    knob_items=group.knobs().items()\n  except Exception:\n    knob_items=\[]\n  for name, knob in knob_items:\n    if name == 'cam_master_mix':\n      knob_map.setdefault(1, \[]).append((name, knob))\n      continue\n    if name.startswith('cam_'):\n      parts=name.split('_')\n      if len(parts) >= 3 and parts\[1].isdigit():\n        idx=int(parts\[1])\n        suffix='_'.join(parts\[2:])\n        if suffix in ('mix','border_blur'):\n          knob_map.setdefault(idx, \[]).append((name, knob))\n          continue\n    if name.startswith('Cam_'):\n      parts=name.split('_')\n      if len(parts) >= 3 and parts\[1].isdigit():\n        idx=int(parts\[1])\n        suffix='_'.join(parts\[2:])\n        if suffix == 'offset':\n          knob_map.setdefault(idx, \[]).append((name, knob))\n          continue\n\n  _debug('visibility active: ' + str(active))\n  _debug('visibility knob_map: ' + str(\{k:\[n for n,_ in v] for k,v in knob_map.items()\}))\n\n  prev_mask=_get_active_cam_mask(group)\n  new_mask=0\n  for idx, is_active in active.items():\n    if is_active:\n      new_mask |= (1 << (idx - 1))\n  _debug('visibility cam mask prev=' + str(prev_mask) + ' new=' + str(new_mask))\n\n  for idx, items in knob_map.items():\n    visible = active.get(idx, False)\n    newly_active = visible and idx >= 2 and not (prev_mask & (1 << (idx - 1)))\n    if newly_active:\n      _set_node_knob(group, 'toggle_cam_' + str(idx).zfill(2), 'mix', 1)\n    _debug('visibility idx \{0\} -> \{1\} names=\{2\}'.format(idx, visible, \[n for n,_ in items]))\n    if not visible:\n      _zero_camera_controls(group, idx)\n    for name, knob in items:\n      if newly_active and name.endswith('_mix') and knob:\n        try:\n          knob.setValue(1)\n        except Exception as exc:\n          _debug('visibility setValue failed for ' + name + ': ' + str(exc))\n      if not visible and name.endswith('_mix') and knob:\n        try:\n          knob.setValue(0)\n        except Exception as exc:\n          _debug('visibility setValue failed for ' + name + ': ' + str(exc))\n      _set_knob_visible(group, knob, visible, name)\n\n  _set_active_cam_mask(group, new_mask)\n\npair_specs=_projection_pairs()\npairs=\[]\nfor img_name, cam_name, target_name, img_idx, cam_idx in pair_specs:\n  img=_safe_input(n, img_idx)\n  cam=_safe_input(n, cam_idx)\n  pairs.append((img_name, cam_name, target_name, img, cam))\n\npair_count=0\nfor img_name, cam_name, target_name, img, cam in pairs:\n  if img and cam:\n    pair_count+=1\n_update_pair_count(n, pair_count)\n_apply_camera_knob_visibility(n, pairs)\n\ninvalid_cams=\[]\nfor img_name, cam_name, target_name, img, cam in pairs:\n  if not cam:\n    continue\n  resolved=_resolve_camera_input(cam)\n  if not resolved:\n    invalid_cams.append(cam_name)\n    continue\n  _debug('updating ' + target_name + ' from ' + cam_name)\n  _update_camera_from_input(n, resolved, target_name)\n\nif invalid_cams:\n  try:\n    nuke.message('Camera inputs must be Camera/Camera2/Camera3: ' + ', '.join(invalid_cams))\n  except Exception:\n    pass\n\ngeo_index=None\ntry:\n  n.begin()\n  geo_node=nuke.toNode('geo')\n  if geo_node and geo_node.knob('number'):\n    try:\n      geo_index=int(geo_node\['number'].value())\n    except Exception:\n      geo_index=None\nfinally:\n  n.end()\nif geo_index is None:\n  geo_index=0\ngeo_input=None\ntry:\n  geo_input=_safe_input(n, geo_index)\nexcept Exception:\n  geo_input=None\nif geo_input:\n  _update_geo(n, geo_input)\n" +STARTLINE}
 addUserKnob {3 charon_rig_cam_count l "Projection Cameras Found" +DISABLED}
 charon_rig_cam_count 2
 addUserKnob {26 ""}
 addUserKnob {26 output_setting l "OUTPUT SETTINGS"}
 addUserKnob {1 asset_name l "Asset Name"}
 addUserKnob {1 subname l "Sub Name"}
 addUserKnob {7 bake_resolution l "Bake Resolution"}
 bake_resolution 4096
 addUserKnob {22 debug_resolution l "Debug Resolution" -STARTLINE +INVISIBLE T "n=nuke.thisNode()\nimport nuke\nroot=nuke.root()\ntry:\n  res=int(n\['bake_resolution'].value())\nexcept Exception:\n  nuke.message('Bake Resolution must be a number')\n  raise SystemExit\nname='bake_\{0\}'.format(res)\nfmt_string='\{0\} \{0\} 0 0 \{0\} \{0\} 1 \{1\}'.format(res, name)\ntry:\n  nuke.addFormat(fmt_string)\nexcept Exception:\n  pass\ntry:\n  for f in nuke.formats():\n    if f.name()==name:\n      root\['format'].setValue(f)\n      raise SystemExit\nexcept SystemExit:\n  pass\nexcept Exception:\n  pass\ntry:\n  root\['format'].setValue(name)\nexcept Exception:\n  pass\n"}
 addUserKnob {1 aces_mode l "Color Mode" +DISABLED}
 aces_mode sRGB
 addUserKnob {26 path_preview l "Preview Path" t //buck/work/current/LIGHTHOUSE_LOBSTER_ROLL_ANCME-L0001/Production/MAYA/sourceimages/work.kien/_CHARON/ T //buck/work/current/LIGHTHOUSE_LOBSTER_ROLL_ANCME-L0001/Production/MAYA/sourceimages/work.kien/_CHARON/}
 addUserKnob {22 write l "Bake Texture" T "import os\nimport getpass\nimport nuke\n\nINVERSE_VIEW_TRANSFORM_GROUP = \"\"\"set cut_paste_input \[stack 0]\nversion 16.0 v3\npush \$cut_paste_input\nGroup \{\n name InverseViewTransform1\n selected true\n xpos 1274\n ypos 1193\n addUserKnob \{20 User\}\n addUserKnob \{26 viewTransform l \"View Transform\" T \"Driven by Root > Color > Thumbnails setting\\\\n\\\\nAutomatic alpha channel detection\"\}\n addUserKnob \{41 view l \"view transform\" T OCIODisplayLinked1.view\}\n addUserKnob \{41 display l \"display device\" T OCIODisplayLinked1.display\}\n\}\n Input \{\n  inputs 0\n  name Input1\n  xpos -468\n  ypos 495\n \}\n OCIOColorSpace \{\n  in_colorspace compositing_linear\n  out_colorspace default\n  name OCIOColorSpace2\n  xpos -468\n  ypos 626\n \}\n OCIODisplay \{\n  colorspace compositing_linear\n  display \"sRGB Display\"\n  view \{\{root.monitorLut x1002 1 x1023 1\}\}\n  invert true\n  name OCIODisplayLinked1\n  note_font Verdana\n  note_font_size 12\n  xpos -468\n  ypos 652\n  addUserKnob \{20 User\}\n  addUserKnob \{26 viewer_note l \"View Transform\" T \"Driven by Root > Color > Thumbnails setting\"\}\n \}\n Output \{\n  name Output1\n  xpos -468\n  ypos 776\n \}\nend_group\n\"\"\"\n\nn = nuke.thisNode()\n\n# CONFIG\nasset = n\['asset_name'].value()\nsub = n\['subname'].value()\ndef _scene_uses_aces():\n    try:\n        cm = nuke.root()\[\"colorManagement\"].value()\n    except Exception:\n        cm = \"\"\n    return \"OCIO\" in str(cm).upper()\n\n\naces = _scene_uses_aces()\ntry:\n    n\[\"aces_mode\"].setValue(\"ACES\" if aces else \"sRGB\")\nexcept Exception:\n    try:\n        n\[\"aces_mode\"].setValue(1 if aces else 0)\n    except Exception:\n        pass\n\n# UV size: U/V tile counts (1-based). If either value is 0, treat as legacy start/end.\nuvs = n\['uvsize'].value()\nu_val = int(uvs\[0])\nv_val = int(uvs\[1])\n\ndef iter_tiles():\n    if u_val <= 0 or v_val <= 0:\n        start_idx = max(0, u_val)\n        end_idx = max(start_idx, v_val)\n        for idx in range(start_idx, end_idx + 1):\n            u = idx % 10\n            v = idx // 10\n            yield u, v\n    else:\n        u_count = max(1, u_val)\n        v_count = max(1, v_val)\n        for v in range(v_count):\n            for u in range(u_count):\n                yield u, v\n\n\ndef _apply_bake_resolution(root, node):\n    if not root or not root.knob(\"format\"):\n        return None\n    try:\n        res = int(node\[\"bake_resolution\"].value())\n    except Exception:\n        return None\n    name = \"bake_\{0\}\".format(res)\n    fmt_string = \"\{0\} \{0\} 0 0 \{0\} \{0\} 1 \{1\}\".format(res, name)\n    try:\n        nuke.addFormat(fmt_string)\n    except Exception:\n        pass\n    try:\n        for f in nuke.formats():\n            if f.name() == name:\n                root\[\"format\"].setValue(f)\n                return name\n    except Exception:\n        pass\n    try:\n        root\[\"format\"].setValue(name)\n    except Exception:\n        pass\n    return name\n\n\ndef _ensure_anchor(node):\n    k = None\n    try:\n        k = node.knob(\"charon_link_anchor\")\n    except Exception:\n        k = None\n    if not k:\n        try:\n            k = nuke.Double_Knob(\"charon_link_anchor\", \"Anchor\")\n            k.setFlag(nuke.NO_ANIMATION | nuke.INVISIBLE)\n            node.addKnob(k)\n        except Exception:\n            k = None\n    return k\n\n\ndef _ensure_contact_knob(node):\n    k = None\n    try:\n        k = node.knob(\"charon_contact_sheet\")\n    except Exception:\n        k = None\n    if not k:\n        try:\n            k = nuke.String_Knob(\"charon_contact_sheet\", \"Contact Sheet\", \"\")\n            k.setFlag(nuke.NO_ANIMATION | nuke.INVISIBLE)\n            node.addKnob(k)\n        except Exception:\n            k = None\n    return k\n\n\ndef _build_contact_sheet(group, out_dir, tiles, cols, rows, aces_enabled=None):\n    if not tiles:\n        return\n    parent = group.parent() or nuke.root()\n    try:\n        parent.begin()\n        existing_name = \"\"\n        try:\n            existing_name = group.knob(\"charon_contact_sheet\").value()\n        except Exception:\n            existing_name = \"\"\n        if existing_name:\n            try:\n                existing = nuke.toNode(existing_name)\n                if existing:\n                    nuke.delete(existing)\n            except Exception:\n                pass\n\n        for node in list(nuke.allNodes()):\n            try:\n                node_name = node.name()\n            except Exception:\n                node_name = \"\"\n            if node_name.startswith(\"TextureBake_CS_Read_\"):\n                nuke.delete(node)\n                continue\n            if node_name.startswith(\"TextureBake_CS_IVT_\"):\n                nuke.delete(node)\n                continue\n            if node_name.startswith(\"TextureBake_ContactSheet_\"):\n                nuke.delete(node)\n\n        for node in nuke.selectedNodes():\n            node.setSelected(False)\n\n        safe_name = \"\".join(c if c.isalnum() else \"_\" for c in group.name())\n        cs_group = nuke.createNode(\"Group\", inpanel=False)\n        cs_group.setName(\"Charon_ContactSheet_\{0\}\".format(safe_name))\n        try:\n            cs_group\[\"tile_color\"].setValue(0xFFFF00FF)\n        except Exception:\n            pass\n        try:\n            cs_group\[\"lock_connections\"].setValue(True)\n        except Exception:\n            pass\n        try:\n            cs_group.setXYpos(group.xpos() + 200, group.ypos() + 100)\n        except Exception:\n            pass\n\n        contact_knob = _ensure_contact_knob(group)\n        if contact_knob:\n            try:\n                contact_knob.setValue(cs_group.name())\n            except Exception:\n                pass\n\n        _ensure_anchor(group)\n        anchor = _ensure_anchor(cs_group)\n        if anchor:\n            try:\n                anchor.setExpression(\"\{0\}.charon_link_anchor\".format(group.fullName()))\n            except Exception:\n                pass\n\n        cs_group.begin()\n\n        cols = max(1, int(cols))\n        rows = max(1, int(rows))\n\n        cs = nuke.createNode(\"ContactSheet\")\n        cs\[\"width\"].setValue(cols * 1024)\n        cs\[\"height\"].setValue(rows * 1024)\n        cs\[\"rows\"].setValue(rows)\n        cs\[\"columns\"].setValue(cols)\n        cs\[\"roworder\"].setValue(\"BottomTop\")\n        cs\[\"gap\"].setValue(10)\n        cs\[\"center\"].setValue(True)\n\n        for i, (u, v) in enumerate(tiles):\n            udim = 1001 + u + (v * 10)\n            fname = \"\{0\}_\{1\}_\{2\}.png\".format(asset, sub, udim)\n            path = os.path.join(out_dir, fname).replace(\"\\\\\", \"/\")\n            r = nuke.createNode(\"Read\")\n            r.setName(\"TextureBake_CS_Read_\{0\}\".format(i + 1))\n            r\[\"file\"].setValue(path)\n            r\[\"on_error\"].setValue(\"nearest frame\")\n            r.setXYpos(i * 150, -300)\n\n            txt = nuke.createNode(\"Text2\", inpanel=False)\n            txt.setInput(0, r)\n            try:\n                txt\[\"message\"].setValue(os.path.basename(path))\n                txt\[\"box\"].setValue(\[0, 0, 1000, 100])\n                txt\[\"yjustify\"].setValue(\"bottom\")\n                txt\[\"global_font_scale\"].setValue(0.5)\n                try:\n                    txt\[\"font\"].setValue(\"Myanmar Text\", \"Regular\")\n                except Exception:\n                    pass\n            except Exception:\n                pass\n            txt.setXYpos(r.xpos(), r.ypos() + 150)\n\n            cs.setInput(i, txt)\n            r.setSelected(False)\n            txt.setSelected(False)\n\n        last_node = cs\n\n        if aces_enabled is None:\n            try:\n                from charon import color_management\n                aces_enabled = color_management.is_aces_enabled()\n            except Exception:\n                aces_enabled = False\n\n        if aces_enabled:\n            ivt_temp = None\n            try:\n                import uuid\n                temp_root = None\n                try:\n                    from charon.paths import get_charon_temp_dir\n                    temp_root = get_charon_temp_dir()\n                except Exception:\n                    temp_root = None\n                if not temp_root:\n                    import tempfile\n                    temp_root = tempfile.gettempdir()\n                ivt_temp = os.path.join(\n                    temp_root,\n                    \"ivt_cs_\{0\}.nk\".format(str(uuid.uuid4())\[:8]),\n                ).replace(\"\\\\\", \"/\")\n                with open(ivt_temp, \"w\") as handle:\n                    handle.write(INVERSE_VIEW_TRANSFORM_GROUP)\n\n                for node in nuke.selectedNodes():\n                    node.setSelected(False)\n                cs.setSelected(True)\n\n                nuke.nodePaste(ivt_temp)\n                ivt_node = nuke.selectedNode()\n                if ivt_node:\n                    ivt_node.setInput(0, cs)\n                    ivt_node.setXpos(cs.xpos())\n                    ivt_node.setYpos(cs.ypos() + 200)\n                    try:\n                        ivt_node\[\"tile_color\"].setValue(0x0000FFFF)\n                        ivt_node\[\"gl_color\"].setValue(0x0000FFFF)\n                    except Exception:\n                        pass\n                    last_node = ivt_node\n            except Exception:\n                pass\n            finally:\n                if ivt_temp and os.path.exists(ivt_temp):\n                    try:\n                        os.remove(ivt_temp)\n                    except Exception:\n                        pass\n\n        out = nuke.createNode(\"Output\")\n        out.setInput(0, last_node)\n        out.setXYpos(last_node.xpos(), last_node.ypos() + 200)\n\n        cs_group.end()\n    finally:\n        if group:\n            group.begin()\n\n\ndef _set_write_knob(node, name, value):\n    try:\n        if node.knob(name):\n            node\[name].setValue(value)\n    except Exception:\n        pass\n\n\ndef _set_exr_colorspace(node, colorspace):\n    for knob_name in (\"colorspace\", \"file_colorspace\", \"ocioColorspace\"):\n        _set_write_knob(node, knob_name, colorspace)\n\n\n# PATH RESOLUTION\nproject_path = os.environ.get(\"BUCK_PROJECT_PATH\")\nuser = getpass.getuser()\n\nif not project_path:\n    ref = n.node(\"Read11\")\n    if ref:\n        path = ref\[\"file\"].value().replace(\"\\\\\", \"/\")\n        if \"/Production/\" in path:\n            project_path = path.split(\"/Production/\")\[0]\n\nif not project_path:\n    nuke.message(\"Could not determine BUCK_PROJECT_PATH.\")\nelse:\n    out_dir = os.path.join(\n        project_path,\n        \"Production\",\n        \"MAYA\",\n        \"sourceimages\",\n        \"work.\{0\}\".format(user),\n        \"_CHARON\",\n        asset,\n        sub,\n    )\n    out_dir_norm = os.path.normpath(out_dir)\n    out_dir_display = out_dir_norm.replace(\"\\\\\", \"/\")\n\n    if not os.path.exists(out_dir_norm):\n        try:\n            os.makedirs(out_dir_norm)\n        except Exception:\n            pass\n\n    tiles_preview = list(iter_tiles())\n    existing_outputs = \[]\n    for u, v in tiles_preview:\n        udim = 1001 + u + (v * 10)\n        for ext in (\"png\", \"exr\"):\n            fname = \"\{0\}_\{1\}_\{2\}.\{3\}\".format(asset, sub, udim, ext)\n            path = os.path.join(out_dir_norm, fname)\n            try:\n                if os.path.exists(path):\n                    existing_outputs.append(path)\n            except Exception:\n                pass\n    proceed = True\n    if existing_outputs:\n        message = \"Existing outputs found in:\\n\{0\}\\n\\nOverwrite \{1\} file(s)?\".format(\n            out_dir_display,\n            len(existing_outputs),\n        )\n        if not nuke.ask(message):\n            nuke.message(\"Bake canceled.\")\n            proceed = False\n\n    if proceed:\n        with nuke.root():\n            root = nuke.root()\n            original_format = None\n            try:\n                if root.knob(\"format\"):\n                    original_format = root\[\"format\"].value()\n            except Exception:\n                original_format = None\n    \n            _apply_bake_resolution(root, n)\n    \n            input_node = n\n            aces_node = None\n    \n            if aces:\n                aces_node = nuke.createNode(\"OCIODisplay\", inpanel=False)\n                aces_node.setInput(0, n)\n                aces_node\[\"colorspace\"].setValue(\"scene_linear\")\n                aces_node\[\"display\"].setValue(\"sRGB Display\")\n                aces_node\[\"view\"].setValue(\"ACES 1.0 SDR-video\")\n                input_node = aces_node\n    \n            w = nuke.createNode(\"Write\", inpanel=False)\n            w.setInput(0, input_node)\n            w\[\"file_type\"].setValue(\"png\")\n            w\[\"channels\"].setValue(\"rgba\")\n    \n            if aces:\n                w\[\"raw\"].setValue(True)\n    \n            w_exr = nuke.createNode(\"Write\", inpanel=False)\n            w_exr.setInput(0, n)\n            w_exr\[\"file_type\"].setValue(\"exr\")\n            w_exr\[\"channels\"].setValue(\"rgba\")\n            _set_write_knob(w_exr, \"raw\", False)\n            _set_exr_colorspace(w_exr, \"scene_linear\")\n    \n            try:\n                for u, v in iter_tiles():\n                    udim = 1001 + u + (v * 10)\n    \n                    n\[\"UVcoord\"].setValue(\[u, v])\n    \n                    fname = \"\{0\}_\{1\}_\{2\}.png\".format(asset, sub, udim)\n                    w\[\"file\"].setValue(out_dir_display + \"/\" + fname)\n    \n                    fname_exr = \"\{0\}_\{1\}_\{2\}.exr\".format(asset, sub, udim)\n                    w_exr\[\"file\"].setValue(out_dir_display + \"/\" + fname_exr)\n    \n                    nuke.execute(w, nuke.frame(), nuke.frame())\n                    nuke.execute(w_exr, nuke.frame(), nuke.frame())\n    \n                tiles = list(iter_tiles())\n                if u_val > 0 and v_val > 0:\n                    cols = max(1, u_val)\n                    rows = max(1, v_val)\n                else:\n                    cols = 1\n                    rows = 1\n                    if tiles:\n                        min_u = min(t\[0] for t in tiles)\n                        max_u = max(t\[0] for t in tiles)\n                        min_v = min(t\[1] for t in tiles)\n                        max_v = max(t\[1] for t in tiles)\n                        cols = max_u - min_u + 1\n                        rows = max_v - min_v + 1\n                _build_contact_sheet(n, out_dir_norm, tiles, cols, rows, aces)\n                nuke.message(\"Bake Complete!\\\\nSaved to: \" + out_dir_display)\n            except Exception as exc:\n                nuke.message(\"Error during bake: \" + str(exc))\n            finally:\n                nuke.delete(w)\n                nuke.delete(w_exr)\n                if aces_node:\n                    nuke.delete(aces_node)\n                n\[\"UVcoord\"].setValue(\[0, 0])\n                if original_format and root.knob(\"format\"):\n                    try:\n                        if hasattr(original_format, \"name\"):\n                            root\[\"format\"].setValue(original_format.name())\n                        else:\n                            root\[\"format\"].setValue(original_format)\n                    except Exception:\n                        pass" +STARTLINE}
 addUserKnob {22 open_folder l "Open Output Location" -STARTLINE T "n=nuke.thisNode()\nimport os, getpass, subprocess\nasset = n\['asset_name'].value()\nsub = n\['subname'].value()\nproject_path = os.environ.get('BUCK_PROJECT_PATH')\nuser = getpass.getuser()\nif not project_path:\n    ref = n.node('Read11')\n    if ref:\n        path = ref\['file'].value().replace('\\\\', '/')\n        if '/Production/' in path:\n            project_path = path.split('/Production/')\[0]\nif project_path:\n    out_dir = os.path.join(project_path, \"Production\", \"MAYA\", \"sourceimages\", \"work.\{\}\".format(user), \"_CHARON\", asset, sub)\n    out_dir_norm = os.path.normpath(out_dir)\n    out_dir_display = out_dir_norm.replace('\\\\', '/')\n    if os.path.exists(out_dir_norm):\n        if os.name == 'nt':\n            os.startfile(out_dir_norm)\n        elif os.name == 'posix':\n            subprocess.Popen(\['open', out_dir_norm])\n        else:\n            subprocess.Popen(\['xdg-open', out_dir_norm])\n    else:\n        nuke.message('Folder does not exist yet: ' + out_dir_display)\nelse:\n    nuke.message('Could not determine project path.')"}
